+struct rdump_link {
+	ext2_ino_t ino;
+	char *path;
+	struct rdump_link *next;
+};
+
+static struct rdump_link *rdump_links;
+
+static const char *rdump_link_path(ext2_ino_t ino)
+{
+	struct rdump_link *entry;
+
+	for (entry = rdump_links; entry; entry = entry->next) {
+		if (entry->ino == ino)
+			return entry->path;
+	}
+	return NULL;
+}
+
+static int remember_rdump_link(ext2_ino_t ino, const char *path)
+{
+	struct rdump_link *entry = calloc(1, sizeof(*entry));
+
+	if (!entry)
+		return ENOMEM;
+	entry->path = strdup(path);
+	if (!entry->path) {
+		free(entry);
+		return ENOMEM;
+	}
+	entry->ino = ino;
+	entry->next = rdump_links;
+	rdump_links = entry;
+	return 0;
+}
+
+static void free_rdump_links(void)
+{
+	struct rdump_link *entry;
+
+	while ((entry = rdump_links)) {
+		rdump_links = entry->next;
+		free(entry->path);
+		free(entry);
+	}
+}
