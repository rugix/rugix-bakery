+#if defined(HAVE_SYS_XATTR_H) || defined(HAVE_ATTR_XATTR_H)
+struct rdump_xattr_context {
+	const char *cmd;
+	const char *name;
+	struct ext2_xattr_handle *handle;
+	int fd;
+	int failed;
+};
+
+static int set_rdump_xattr(char *xattr_name, char *value EXT2FS_ATTR((unused)),
+			   size_t value_len EXT2FS_ATTR((unused)),
+			   void *data)
+{
+	struct rdump_xattr_context *ctx = data;
+	void *converted_value = NULL;
+	size_t converted_value_len;
+	errcode_t err;
+	int retval;
+
+	err = ext2fs_xattr_get(ctx->handle, xattr_name, &converted_value,
+			       &converted_value_len);
+	if (err) {
+		com_err(ctx->cmd, err,
+			"while reading extended attribute %s from %s",
+			xattr_name, ctx->name);
+		ctx->failed = 1;
+		return XATTR_ABORT;
+	}
+
+	if (ctx->fd == -1)
+		retval = lsetxattr(ctx->name, xattr_name, converted_value,
+				   converted_value_len, 0);
+	else
+		retval = fsetxattr(ctx->fd, xattr_name, converted_value,
+				   converted_value_len, 0);
+	ext2fs_free_mem(&converted_value);
+	if (retval == -1) {
+		com_err(ctx->cmd, errno,
+			"while setting extended attribute %s on %s",
+			xattr_name, ctx->name);
+		ctx->failed = 1;
+		return XATTR_ABORT;
+	}
+	return 0;
+}
+
+static void fix_xattrs(const char *cmd, ext2_ino_t ino, int fd,
+		       const char *name)
+{
+	struct ext2_xattr_handle *handle;
+	struct rdump_xattr_context ctx = {
+		.cmd = cmd,
+		.name = name,
+		.fd = fd,
+	};
+	errcode_t retval;
+
+	retval = ext2fs_xattrs_open(current_fs, ino, &handle);
+	if (retval == EXT2_ET_MISSING_EA_FEATURE)
+		return;
+	if (retval) {
+		com_err(cmd, retval, "while opening extended attributes for %s",
+			name);
+		debugfs_cmd_status = 1;
+		return;
+	}
+
+	retval = ext2fs_xattrs_read(handle);
+	if (retval) {
+		com_err(cmd, retval, "while reading extended attributes for %s",
+			name);
+		debugfs_cmd_status = 1;
+		goto out;
+	}
+
+	ctx.handle = handle;
+	retval = ext2fs_xattrs_iterate(handle, set_rdump_xattr, &ctx);
+	if (retval) {
+		com_err(cmd, retval, "while iterating extended attributes for %s",
+			name);
+		debugfs_cmd_status = 1;
+	}
+	if (ctx.failed)
+		debugfs_cmd_status = 1;
+
+out:
+	retval = ext2fs_xattrs_close(&handle);
+	if (retval) {
+		com_err(cmd, retval, "while closing extended attributes for %s",
+			name);
+		debugfs_cmd_status = 1;
+	}
