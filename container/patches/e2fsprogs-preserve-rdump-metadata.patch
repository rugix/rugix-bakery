+static int rdump_special(ext2_ino_t ino, struct ext2_inode *inode,
+			 const char *fullname)
+{
+	mode_t mode = mode_xlate(inode->i_mode);
+	dev_t device = 0;
+	int major, minor;
+
+	if (LINUX_S_ISCHR(inode->i_mode) || LINUX_S_ISBLK(inode->i_mode)) {
+		if (inode->i_block[0]) {
+			major = (inode->i_block[0] >> 8) & 255;
+			minor = inode->i_block[0] & 255;
+		} else {
+			major = (inode->i_block[1] & 0xfff00) >> 8;
+			minor = ((inode->i_block[1] & 0xff) |
+				 ((inode->i_block[1] >> 12) & 0xfff00));
+		}
+		device = makedev(major, minor);
+		mode |= LINUX_S_ISCHR(inode->i_mode) ? S_IFCHR : S_IFBLK;
+		if (mknod(fullname, mode, device) == -1)
+			goto error;
+	} else if (LINUX_S_ISFIFO(inode->i_mode)) {
+		if (mkfifo(fullname, mode) == -1)
+			goto error;
+	} else {
+		com_err("rdump", EOPNOTSUPP,
+			"while exporting unsupported socket %s", fullname);
+		debugfs_cmd_status = 1;
+		return -1;
+	}
+
+	fix_perms("rdump", inode, -1, fullname);
+	fix_xattrs("rdump", ino, -1, fullname);
+	return debugfs_cmd_status ? -1 : 0;
+
+error:
+	com_err("rdump", errno, "while creating special file %s", fullname);
+	debugfs_cmd_status = 1;
+	return -1;
