{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_bakery.mixins.MixinConfig",
  "type": "object",
  "description": "Mixin configuration.",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/rugix_bakery.recipes.ParameterValue"
        }
      }
    }
  },
  "required": [],
  "unevaluatedProperties": false,
  "$defs": {
    "rugix_bakery.recipes.ParameterValue": {
      "$id": "rugix_bakery.recipes.ParameterValue",
      "description": "Value of a parameter.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number"
        }
      ]
    }
  }
}