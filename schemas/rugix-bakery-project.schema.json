{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_bakery.projects.ProjectConfig",
  "type": "object",
  "description": "Project configuration.",
  "properties": {
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_bakery.repositories.SourceConfig"
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_bakery.systems.SystemConfig"
      }
    }
  },
  "required": [],
  "unevaluatedProperties": false,
  "$defs": {
    "rugix_bakery.foreign.NumBytes": {
      "type": [
        "string",
        "number"
      ],
      "description": "Number of bytes."
    },
    "rugix_bakery.images.Filesystem": {
      "description": "Filesystem.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ext4"
            },
            "additional-options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "clamp-mtime": {
              "$ref": "#/$defs/rugix_bakery.images.Timestamp"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "fat32"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "squashfs"
            },
            "additional-options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "no-compression": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "rugix_bakery.images.ImageLayout": {
      "type": "object",
      "description": "Layout of an image.",
      "properties": {
        "type": {
          "$ref": "#/$defs/rugix_bakery.images.PartitionTableType"
        },
        "raw-blobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rugix_bakery.images.RawBlob"
          }
        },
        "partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rugix_bakery.images.ImagePartition"
          }
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_bakery.images.ImagePartition": {
      "type": "object",
      "description": "Partition of an image.",
      "properties": {
        "size": {
          "$ref": "#/$defs/rugix_bakery.foreign.NumBytes"
        },
        "filesystem": {
          "$ref": "#/$defs/rugix_bakery.images.Filesystem"
        },
        "root": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/rugix_bakery.images.PartitionType"
        },
        "bootable": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_bakery.images.PartitionTableType": {
      "enum": [
        "mbr",
        "gpt"
      ],
      "description": "Partition table type."
    },
    "rugix_bakery.images.PartitionType": {
      "type": "string",
      "description": "Partition type."
    },
    "rugix_bakery.images.RawBlob": {
      "type": "object",
      "description": "Raw firmware blob written at a fixed offset on the disk.",
      "properties": {
        "file": {
          "type": "string"
        },
        "offset": {
          "$ref": "#/$defs/rugix_bakery.foreign.NumBytes"
        },
        "size": {
          "$ref": "#/$defs/rugix_bakery.foreign.NumBytes"
        }
      },
      "required": [
        "file",
        "offset"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.images.SquashfsOptions": {
      "type": "object",
      "properties": {
        "additional-options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no-compression": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_bakery.images.Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp."
    },
    "rugix_bakery.repositories.SourceConfig": {
      "description": "Repository source.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "git": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "rev": {
              "type": "string"
            },
            "dir": {
              "type": "string"
            }
          },
          "required": [
            "git"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      ]
    },
    "rugix_bakery.rules.ArtifactKind": {
      "enum": [
        "file",
        "directory"
      ],
      "description": "Filesystem object accepted by an input or produced by an output."
    },
    "rugix_bakery.rules.ArtifactSelection": {
      "type": "object",
      "description": "A path within a directory artifact. Symlinks must resolve inside that directory.",
      "properties": {
        "source": {
          "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/rugix_bakery.rules.ArtifactKind"
        }
      },
      "required": [
        "source",
        "path",
        "kind"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.rules.ArtifactSource": {
      "description": "An artifact reference within a composition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rule": {
              "$ref": "#/$defs/rugix_bakery.rules.RuleOutputSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "rule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "select": {
              "$ref": "#/$defs/rugix_bakery.rules.ArtifactSelection"
            }
          },
          "additionalProperties": false,
          "required": [
            "select"
          ]
        },
        {
          "type": "object",
          "properties": {
            "tree": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "tree"
          ]
        }
      ]
    },
    "rugix_bakery.rules.ParameterBinding": {
      "description": "A literal parameter value or a reference to an enclosing parameter.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            }
          },
          "required": [
            "parameter"
          ]
        },
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": [
                "integer",
                "string"
              ],
              "format": "int64",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^(NaN|[+-]?Infinity)$"
            }
          ]
        }
      ]
    },
    "rugix_bakery.rules.RuleInvocation": {
      "type": "object",
      "description": "An invocation of a repository-defined rule.",
      "properties": {
        "uses": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_bakery.rules.ParameterBinding"
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
          }
        }
      },
      "required": [
        "uses"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.rules.RuleOutputSource": {
      "type": "object",
      "description": "Reference to a node output.",
      "properties": {
        "node": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "output"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.systems.Architecture": {
      "enum": [
        "amd64",
        "arm64",
        "armv7",
        "armhf",
        "arm"
      ],
      "description": "Architecture."
    },
    "rugix_bakery.systems.SystemConfig": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "mixins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecture": {
          "$ref": "#/$defs/rugix_bakery.systems.Architecture"
        },
        "target": {
          "$ref": "#/$defs/rugix_bakery.systems.Target"
        },
        "image": {
          "$ref": "#/$defs/rugix_bakery.systems.SystemImageConfig"
        },
        "build": {
          "$ref": "#/$defs/rugix_bakery.rules.RuleInvocation"
        },
        "options": {
          "$ref": "#/$defs/rugix_bakery.systems.SystemOptions"
        }
      },
      "required": [
        "layer",
        "architecture"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.systems.SystemImageConfig": {
      "type": "object",
      "properties": {
        "size": {
          "$ref": "#/$defs/rugix_bakery.foreign.NumBytes"
        },
        "layout": {
          "$ref": "#/$defs/rugix_bakery.images.ImageLayout"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_bakery.systems.SystemOptions": {
      "type": "object",
      "properties": {
        "use-squashfs": {
          "$ref": "#/$defs/rugix_bakery.images.SquashfsOptions"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_bakery.systems.Target": {
      "enum": [
        "generic-grub-efi",
        "rpi-tryboot",
        "rpi-uboot",
        "bsp",
        "unknown"
      ],
      "description": "Target."
    }
  }
}