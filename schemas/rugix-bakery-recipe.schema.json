{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_bakery.recipes.RecipeConfig",
  "type": "object",
  "description": "Recipe configuration.",
  "properties": {
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "type": [
        "integer",
        "string"
      ],
      "format": "int64",
      "pattern": "^-?[0-9]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_bakery.rules.ArtifactInput"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_bakery.rules.RuleInvocation"
      }
    },
    "input-defaults": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rugix_bakery.recipes.ParameterDef"
      }
    }
  },
  "required": [],
  "unevaluatedProperties": false,
  "$defs": {
    "rugix_bakery.recipes.ParameterDef": {
      "type": "object",
      "description": "Recipe parameter definition.",
      "properties": {
        "description": {
          "type": "string"
        },
        "default": {
          "$ref": "#/$defs/rugix_bakery.recipes.ParameterValue"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_bakery.recipes.ParameterValue": {
      "description": "Value of a parameter.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": [
            "integer",
            "string"
          ],
          "format": "int64",
          "pattern": "^-?[0-9]+$"
        },
        {
          "type": [
            "number",
            "string"
          ],
          "pattern": "^(NaN|[+-]?Infinity)$"
        }
      ]
    },
    "rugix_bakery.rules.ArtifactInput": {
      "description": "A compact artifact kind or a documented input.",
      "anyOf": [
        {
          "enum": [
            "file",
            "directory"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/rugix_bakery.rules.ArtifactKind"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "rugix_bakery.rules.ArtifactKind": {
      "enum": [
        "file",
        "directory"
      ],
      "description": "Filesystem object accepted by an input or produced by an output."
    },
    "rugix_bakery.rules.ArtifactSelection": {
      "type": "object",
      "description": "A path within a directory artifact. Symlinks must resolve inside that directory.",
      "properties": {
        "source": {
          "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/rugix_bakery.rules.ArtifactKind"
        }
      },
      "required": [
        "source",
        "path",
        "kind"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.rules.ArtifactSource": {
      "description": "An artifact reference within a composition.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rule": {
              "$ref": "#/$defs/rugix_bakery.rules.RuleOutputSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "rule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "select": {
              "$ref": "#/$defs/rugix_bakery.rules.ArtifactSelection"
            }
          },
          "additionalProperties": false,
          "required": [
            "select"
          ]
        },
        {
          "type": "object",
          "properties": {
            "tree": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "tree"
          ]
        }
      ]
    },
    "rugix_bakery.rules.ParameterBinding": {
      "description": "A literal parameter value or a reference to an enclosing parameter.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string"
            }
          },
          "required": [
            "parameter"
          ]
        },
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": [
                "integer",
                "string"
              ],
              "format": "int64",
              "pattern": "^-?[0-9]+$"
            },
            {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^(NaN|[+-]?Infinity)$"
            }
          ]
        }
      ]
    },
    "rugix_bakery.rules.RuleInvocation": {
      "type": "object",
      "description": "An invocation of a repository-defined rule.",
      "properties": {
        "uses": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_bakery.rules.ParameterBinding"
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rugix_bakery.rules.ArtifactSource"
          }
        }
      },
      "required": [
        "uses"
      ],
      "unevaluatedProperties": false
    },
    "rugix_bakery.rules.RuleOutputSource": {
      "type": "object",
      "description": "Reference to a node output.",
      "properties": {
        "node": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "output"
      ],
      "unevaluatedProperties": false
    }
  }
}