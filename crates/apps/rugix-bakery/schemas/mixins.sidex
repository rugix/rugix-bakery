//! Mixin configuration.

import recipes::ParameterValue
import rules::{ArtifactSource, RuleInvocation}

/// Mixin configuration.
record MixinConfig {
    /// Human-friendly name of the mixin.
    name?: string,
    /// Description of the mixin.
    description?: string,
    /// Other mixins required by this mixin.
    dependencies?: [string],
    /// Recipes to apply with the mixin.
    recipes?: [string],
    /// Recipes to specifically exclude from this mixin.
    exclude?: [string],
    /// Prerequisite rules available to recipe input bindings.
    rules?: [string: RuleInvocation],
    /// Artifact bindings by recipe reference and input name.
    inputs?: [string: [string: ArtifactSource]],
    /// Recipe parameters.
    parameters?: [string: [string: ParameterValue]],
}
