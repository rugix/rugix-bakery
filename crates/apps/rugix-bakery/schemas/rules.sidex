//! Repository-defined artifact builds.

import recipes::{ParameterDef, ParameterValue}
import systems::Architecture

/// A reusable operation or composition.
#[json(rename_all = "kebab-case")]
record RuleDefinition {
    /// Description for users of this rule.
    description?: string,
    /// Optional group used when presenting a rule catalog.
    category?: string,
    /// Artifact inputs. Inputs without a default are required.
    inputs?: [string: RuleInput],
    /// Configurable parameters.
    parameters?: [string: ParameterDef],
    /// Required sensitive input bindings. Secret changes invalidate cached outputs.
    secrets?: [string],
    /// Replaceable operations of a graph. Callers may bind their own implementations.
    rule_parameters?: [string: RuleParameterDef],
    /// Implementation of the rule.
    execution: RuleExecution,
}

/// An artifact input of a rule.
record RuleInput {
    kind: ArtifactKind,
    description?: string,
    /// Binding used when neither the invocation nor its caller supplies the input.
    /// It resolves relative to the rule's repository and cannot reference inputs or nodes.
    default?: ArtifactSource,
}

/// An artifact input with optional documentation.
record ArtifactInput {
    kind: ArtifactKind,
    description?: string,
}

/// An operation that a graph calls through a fixed interface.
///
/// The graph supplies the interface inputs and parameters at each call site and
/// uses the interface outputs. Implementations may require additional inputs,
/// parameters, and secrets, which the binding of the implementation supplies.
record RuleParameterDef {
    /// Description for callers supplying an implementation.
    description?: string,
    /// Artifacts the graph supplies to the implementation.
    inputs?: [string: ArtifactInput],
    /// Parameters the graph supplies to the implementation.
    parameters?: [string: InterfaceParameter],
    /// Artifacts the graph expects from the implementation.
    outputs: [string: ArtifactOutput],
    /// Implementation used unless the caller binds another rule.
    default: RuleInvocation,
}

/// A parameter supplied through a rule parameter interface.
record InterfaceParameter {
    description?: string,
}

/// An artifact output with optional documentation.
record ArtifactOutput {
    kind: ArtifactKind,
    description?: string,
}

/// An invocation of a repository-defined rule.
#[json(rename_all = "kebab-case")]
record RuleInvocation {
    /// Rule to invoke.
    uses: RuleReference,
    /// Artifact input bindings.
    inputs?: [string: ArtifactSource],
    /// Parameter bindings.
    parameters?: [string: ParameterBinding],
    /// Secret input bindings.
    secrets?: [string: ArtifactSource],
    /// Implementations bound to rule parameters of the invoked rule.
    rules?: [string: RuleBinding],
}

/// An implementation bound to a rule parameter.
///
/// Bindings resolve in the scope that contains them. The graph supplies the
/// interface inputs and parameters, which a binding must not bind.
#[json(rename_all = "kebab-case")]
record RuleBinding {
    /// Replacement rule. Omit to keep the default implementation and add bindings.
    uses?: RuleReference,
    /// Additional artifact input bindings.
    inputs?: [string: ArtifactSource],
    /// Additional parameter bindings.
    parameters?: [string: ParameterBinding],
    /// Additional secret input bindings.
    secrets?: [string: ArtifactSource],
    /// Implementations bound to rule parameters of the replacement rule.
    rules?: [string: RuleBinding],
}

/// A rule name or the implementation of an enclosing rule parameter.
#[json(tagged = implicitly)]
variant RuleReference {
    /// Local or repository-qualified rule name.
    Rule: string,
    /// Implementation selected for a rule parameter of the enclosing graph.
    Parameter: RuleParameterReference,
}

/// Reference to a rule parameter of the enclosing graph.
#[json(rename_all = "kebab-case")]
record RuleParameterReference {
    rule_parameter: string,
}

/// Filesystem object accepted by an input or produced by an output.
#[json(tagged = externally, rename_all = "kebab-case")]
#[rust(derive(Copy, PartialEq, Eq))]
variant ArtifactKind {
    File,
    Directory,
}

/// An artifact reference within a composition.
#[json(tagged = externally, rename_all = "kebab-case")]
variant ArtifactSource {
    /// An input of the enclosing composition.
    Input: string,
    /// A file or directory relative to the repository containing this reference.
    Path: string,
    /// An output of another node in this composition.
    Rule: RuleOutputSource,
    /// Select an existing file or directory within a directory artifact.
    Select: ArtifactSelection,
    /// Assemble artifacts at explicit, non-overlapping relative paths.
    Tree: [string: ArtifactSource],
}

/// A path within a directory artifact. Symlinks must resolve inside that directory.
record ArtifactSelection {
    #[rust(box)]
    source: ArtifactSource,
    path: string,
    kind: ArtifactKind,
}

/// Reference to a node output.
record RuleOutputSource {
    node: string,
    output: string,
}

/// A literal parameter value or a reference to an enclosing parameter.
#[json(tagged = implicitly)]
variant ParameterBinding {
    Reference: ParameterReference,
    Value: ParameterValue,
}

/// Reference to an enclosing parameter.
record ParameterReference {
    parameter: string,
}

/// Implementation of a reusable rule.
#[json(tag = "type", rename_all = "kebab-case")]
variant RuleExecution {
    Run: RunRule,
    Graph: GraphRule,
    /// Build an existing layer with its recipes.
    Layer: LayerRule,
}

/// A command executed in Bakery or a fresh tooling environment.
#[json(rename_all = "kebab-case")]
record RunRule {
    /// Optional environment resolved relative to the defining repository. Defaults to Bakery.
    env?: string,
    /// Command and literal arguments. No shell expansion is performed by Bakery.
    command: [string],
    /// Files and directories to publish from /run/rugix/bakery/work/outputs.
    outputs: [string: RuleOutput],
    /// Reuse successful outputs. Defaults to true.
    cache?: bool,
    /// Supply SOURCE_DATE_EPOCH and include it in the cache identity. Defaults to true.
    uses_source_date_epoch?: bool,
}

/// A declared command output.
record RuleOutput {
    /// Description for users of the output artifact.
    description?: string,
    kind: ArtifactKind,
    /// Relative path within /run/rugix/bakery/work/outputs.
    path: string,
}

/// A composition with the same interface as an executable rule.
record GraphRule {
    rules: [string: RuleInvocation],
    outputs: [string: ArtifactSource],
}


/// A layer executed as part of an artifact graph.
record LayerRule {
    /// Layer name resolved from the rule's repository.
    layer: string,
    architecture: Architecture,
}
