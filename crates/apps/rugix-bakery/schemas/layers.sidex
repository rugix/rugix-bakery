//! Layer configuration.

import recipes::ParameterValue
import rules::{ArtifactSource, RuleInvocation}

/// Layer configuration.
record LayerConfig {
    /// Human-friendly name of the layer.
    name?: string,
    /// Description of the layer.
    description?: string,
    /// Optional group used when presenting a layer catalog.
    category?: string,
    /// URL for importing the layer.
    url?: string,
    /// Parent layer.
    parent?: string,
    /// Indicates whether the layer is a root layer.
    root?: bool,
    /// Recipes to build the layer with.
    recipes?: [string],
    /// Recipes to specifically exclude.
    exclude?: [string],
    /// Prerequisite rules available to recipe input bindings.
    rules?: [string: RuleInvocation],
    /// Artifact bindings by recipe reference and input name.
    inputs?: [string: [string: ArtifactSource]],
    /// Recipe parameters.
    parameters?: [string: [string: ParameterValue]],
}
