//! System configuration.

import foreign::NumBytes
import rules::{RuleInvocation, ArtifactSource}
import images::{ImageLayout, SquashfsOptions}

record SystemConfig {
    /// Layer the image is based on.
    layer: string,
    /// Mixins enabled by default for the system.
    mixins?: [string],
    /// Architecture of the image.
    architecture: Architecture,
    /// Rugix Bakery target.
    target?: Target,
    /// System image configuration.
    image?: SystemImageConfig,
    /// System graph rules.
    rules?: [string: RuleInvocation],
    /// Published file names and artifact sources.
    outputs?: [string: ArtifactSource],
    /// Predefined pipeline bundle encoding.
    bundle?: SystemBundleConfig,
    /// Additional options.
    options?: SystemOptions,
}

#[json(rename_all = "kebab-case")]
record SystemOptions {
    /// Use squashfs for system filesystems by default.
    use_squashfs?: SquashfsOptions,
}

/// Architecture.
#[json(rename_all = "lowercase")]
#[json(tagged=externally)]
#[rust(derive(Copy, PartialEq, Eq, Hash))]
variant Architecture {
    /// 64-bit x86.
    Amd64,
    /// 64-bit ARMv8.
    Arm64,
    /// 32-bit ARMv7.
    Armv7,
    /// 32-bit ARMv6 (Hard-Float).
    Armhf,
    /// 32-bit ARMv6.
    Arm,
}

/// Target.
#[json(tagged=externally, rename_all = "kebab-case")]
variant Target {
    /// Generic target for EFI-compatible systems.
    GenericGrubEfi,
    /// Raspberry Pi-specific target using the `tryboot` mechanism.
    RpiTryboot,
    /// Raspberry Pi-specific target using U-Boot.
    RpiUboot,
    /// Custom BSP target — reads disk layout from `bsp/rugix-bsp.toml` in the layer.
    Bsp,
    /// Target for unsupported devices.
    Unknown,
}

record SystemImageConfig {
     /// Size of the image.
     size?: NumBytes,
     /// Layout of the image.
     layout?: ImageLayout,
}

/// Bundle encoding for the predefined pipeline.
#[json(rename_all = "kebab-case")]
record SystemBundleConfig {
    /// Include an update bundle by default.
    enabled?: bool,
    /// Compress payloads with XZ by default.
    compression?: bool,
    /// Chunking algorithm using the CLI syntax.
    chunker?: string,
}
